server {
    listen 80;
    server_name shurl.hyorward.tech;

    root /usr/share/nginx/html;
    index index.html;

    # Создание ссылки: инъекция BasicAuth и проксирование на бэкенд
    location = /url {
        proxy_pass http://backend:8082/url;
        proxy_set_header Host $host;
        proxy_set_header Authorization "${PROXY_AUTH}";
    }

    # Редирект: одиночный сегмент 3–32 символа [A-Za-z0-9_-] = alias → на бэкенд.
    # Диапазон совпадает с валидацией хвоста во фронте (ALIAS_RE в shorten.ts).
    # Статика (/assets/*, /favicon.ico) сюда не попадает: содержит «/» или «.».
    location ~ "^/[A-Za-z0-9_-]{3,32}$" {
        proxy_pass http://backend:8082;
        proxy_set_header Host $host;
    }

    # SPA: статика и фолбэк
    location / {
        try_files $uri $uri/ /index.html;
    }
}
